# Local development only. Generate your copy with: node scripts/setup-local.mjs
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://fleming:fleming-local-only@127.0.0.1:54329/fleming_local
JWT_SECRET=GENERATE_LOCAL_JWT_SECRET
SEED_ADMIN_PASSWORD=GENERATE_LOCAL_ADMIN_PASSWORD
BANK_FEED_ENCRYPTION_KEY=GENERATE_LOCAL_BANK_KEY
PORTAL_CREDENTIALS_KEY=GENERATE_LOCAL_PORTAL_KEY
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
CRM_URL=http://localhost:5173
UPLOADS_PATH=./uploads
FLEMO_ACCOUNT_PATH=./flemo-accounts
ALLOW_SIMULATED_MESSAGES=true

# Leave providers blank for the local demo. Real keys enable real operations.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SENDER_ID=
FREEAGENT_CLIENT_ID=
FREEAGENT_CLIENT_SECRET=
FREEAGENT_REDIRECT_URI=
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=
TRUELAYER_ENV=sandbox
EPC_API_TOKEN=
COMPANIES_HOUSE_API_KEY=
COUNCIL_TAX_API_KEY=
FEEDBACK_AGENT_TOKEN=
SENTRY_DSN=

# Optional: full path to soffice/soffice.exe if LibreOffice is not on PATH.
# LIBREOFFICE_PATH="C:/Program Files/LibreOffice/program/soffice.exe"
# Optional: full path to pdftotext for Flemo PDF text extraction.
# PDFTOTEXT_PATH=
# For Windows PDF fonts (the setup script detects the standard location):
# PDF_ARIAL_REGULAR="C:/Windows/Fonts/arial.ttf"
# PDF_ARIAL_BOLD="C:/Windows/Fonts/arialbd.ttf"
