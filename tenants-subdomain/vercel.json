{
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "report.fleminglettings.co.uk" }], "destination": "/report.html" },
    { "source": "/onboarding/:token", "destination": "/application.html" },
    { "source": "/agreement/:token", "destination": "/agreement.html" },
    { "source": "/report", "destination": "/report.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
